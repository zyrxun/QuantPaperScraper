# Discord Bot Credentials (Optional: can also be configured in-memory during launch)
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# GLM (Zhipu AI or OpenAI-compatible endpoint) Configuration
# NOTE: For maximum security, leave GLM_API_KEY empty. The app prompts for it on launch and keeps it in RAM only!
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# Supports glm-5.3-plus (default), glm-4-plus, etc.
GLM_MODEL=glm-5.3-plus
